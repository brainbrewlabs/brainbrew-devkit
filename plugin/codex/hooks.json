{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node '{{PLUGIN_ROOT}}/scripts/codex-runner.cjs' SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node '{{PLUGIN_ROOT}}/scripts/codex-runner.cjs' UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|Agent|Task|task|apply_patch|exec_command|spawn_agent|wait_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node '{{PLUGIN_ROOT}}/scripts/codex-runner.cjs' PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node '{{PLUGIN_ROOT}}/scripts/codex-runner.cjs' PermissionRequest",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|Agent|Task|task|apply_patch|exec_command|spawn_agent|wait_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node '{{PLUGIN_ROOT}}/scripts/codex-runner.cjs' PostToolUse",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node '{{PLUGIN_ROOT}}/scripts/codex-runner.cjs' Stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
